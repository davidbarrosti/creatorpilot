{
  "name": "creatorpilot",
  "version": "0.1.0",
  "description": "Dashboard for TikTok Shop Affiliate Creators",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "db:migrate": "supabase migration new && supabase db push",
    "db:pull": "supabase db pull",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "supabase db reset",
    "env:check": "node scripts/check-env.js",
    "generate:types": "supabase gen types typescript > src/types/supabase.ts",
    "api:test:tiktok": "tsx scripts/test-tiktok-api.ts",
    "api:test:claude": "tsx scripts/test-claude-api.ts",
    "postinstall": "husky install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.1.0",
    "@next/font": "^14.1.0",
    "typescript": "^5.3.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.2",
    "@radix-ui/react-slot": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@supabase/supabase-js": "^2.38.5",
    "@supabase/auth-ui-react": "^0.4.6",
    "@supabase/auth-ui-shared": "^0.1.6",
    "@anthropic-ai/sdk": "^0.9.1",
    "recharts": "^2.10.3",
    "lucide-react": "^0.294.0",
    "date-fns": "^2.30.0",
    "react-calendar": "^4.2.1",
    "framer-motion": "^10.16.16",
    "zustand": "^4.4.6",
    "swr": "^2.2.4",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.1.0",
    "@playwright/test": "^1.40.1",
    "tsx": "^4.7.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "supabase": "^1.122.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
