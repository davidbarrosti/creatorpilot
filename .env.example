# ============================================
# CreatorPilot Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase (Database + Auth)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Only needed for server-side operations
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/creatorpilot

# ============================================
# Anthropic (Claude API)
# ============================================
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE

# ============================================
# TikTok Shop (Partner Center)
# ============================================
# Get these from: partner.tiktokshop.com → App Management → CreatorPilot
TIKTOK_SHOP_CLIENT_ID=YOUR_CLIENT_ID_HERE
TIKTOK_SHOP_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Sandbox URL (testing): https://sandbox.tiktokshop.com
# Production URL (live): https://tiktokshop.com
TIKTOK_SHOP_API_URL=https://sandbox.tiktokshop.com

# Optional: Sandbox specific credentials (for testing without connecting real account)
TIKTOK_SHOP_SANDBOX_SHOP_ID=YOUR_SANDBOX_SHOP_ID
TIKTOK_SHOP_SANDBOX_CREATOR_ID=YOUR_SANDBOX_CREATOR_ID
TIKTOK_SHOP_SANDBOX_TOKEN=YOUR_SANDBOX_TOKEN

# ============================================
# Development/Testing
# ============================================
# Set to 'true' to use mock data (no need for real APIs during development)
# Set to 'false' to use real TikTok Shop API calls
NEXT_PUBLIC_USE_MOCK=true

# Environment: development, staging, production
NODE_ENV=development

# ============================================
# Optional: Analytics & Error Tracking (Phase 2)
# ============================================
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=

# ============================================
# Optional: Email Notifications (Phase 2)
# ============================================
# SENDGRID_API_KEY=
# NEXT_PUBLIC_SENDGRID_FROM_EMAIL=noreply@creatorpilot.app

# ============================================
# Deployment (Contabo)
# ============================================
# Your VPS domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database for production Supabase (not local)
# Supabase will handle this, just point to their hosted instance
