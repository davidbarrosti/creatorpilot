# ============================================
# CreatorPilot Environment Variables
# ============================================
# Copy to .env.local and fill in your values.
# Status do registro TikTok: ver bugs.md (BUG-001) — ainda bloqueado.

# ============================================
# Supabase (Database + Auth)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ============================================
# Anthropic (Claude API) — usado em src/lib/ai/briefGenerator.ts
# ============================================
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE

# ============================================
# TikTok Shop (Partner Center) — usado em src/lib/tiktok/auth.ts
# ============================================
# Get from: partner.tiktokshop.com → App & Service → CreatorPilot → Manage API
# App criado e scopes ativos (ver bugs.md BUG-001), mas autorização real ainda
# bloqueada por erro de região 36003006 — ver melhorias.md MEL-006.
TIKTOK_SHOP_APP_KEY=YOUR_APP_KEY_HERE
TIKTOK_SHOP_APP_SECRET=YOUR_APP_SECRET_HERE
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_API_VERSION=202501

# ============================================
# Criptografia dos tokens TikTok em repouso (profiles.tiktok_access_token/refresh_token)
# ============================================
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=YOUR_RANDOM_HEX_KEY_HERE

# ============================================
# Apify (fonte de dados interina pro Radar, enquanto MEL-006 não resolve)
# ============================================
# Scraper de terceiros, NÃO é a API oficial do TikTok — só cobre mercado EUA.
# Token em apify.com → Settings → Integrations
APIFY_API_TOKEN=YOUR_APIFY_TOKEN_HERE
APIFY_ACTOR_ID=sentry~tiktok-shop-affiliate-products

# ============================================
# Development
# ============================================
# true = usa dados mockados (src/lib/tiktok/mocks.ts), sem precisar de Supabase/TikTok/Apify reais
NEXT_PUBLIC_USE_MOCK=true
# true = usa a Apify (dados reais, mercado EUA) em vez de mock — só funciona com NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_USE_APIFY=false

NODE_ENV=development
